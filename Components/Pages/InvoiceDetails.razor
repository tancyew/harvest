@page "/invoices/{InvoiceId:int}"
@using Harvest.Models
@using Harvest.Services
@inject InvoiceService InvoiceService
@inject PaymentService PaymentService
@inject GotenbergService GotenbergService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Invoice Details - Harvest</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_invoice == null)
{
    <MudAlert Severity="Severity.Error">Invoice not found</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/invoices" Class="mt-4">
        Back to Invoices
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbItems" Class="mb-4"></MudBreadcrumbs>

    <MudGrid>
        <MudItem xs="12" md="8">
            <!-- Invoice Header Card -->
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5">Invoice @_invoice.InvoiceNumber</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Related Order: <MudLink Href="@($"/orders/{_invoice.SalesOrder.SalesOrderId}")">@_invoice.SalesOrder.OrderNumber</MudLink>
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudChip T="string" Color="@GetStatusColor(_invoice.Status)">@_invoice.Status</MudChip>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Customer</MudText>
                            <MudLink Href="@($"/customers/{_invoice.SalesOrder.Customer.CustomerId}")">
                                <MudText Typo="Typo.body1">@_invoice.SalesOrder.Customer.BusinessName</MudText>
                            </MudLink>
                            <MudText Typo="Typo.body2">@_invoice.SalesOrder.Customer.User.FullName</MudText>
                            <MudText Typo="Typo.body2">@_invoice.SalesOrder.Customer.User.Email</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Invoice Dates</MudText>
                            <MudText Typo="Typo.body2">
                                <strong>Invoice Date:</strong> @_invoice.InvoiceDate.ToString("MMM dd, yyyy")
                            </MudText>
                            <MudText Typo="Typo.body2" Color="@(_invoice.DueDate < DateTime.UtcNow && _invoice.Status != "Paid" ? Color.Error : Color.Default)">
                                <strong>Due Date:</strong> @_invoice.DueDate.ToString("MMM dd, yyyy")
                            </MudText>
                            @if (_invoice.Status == "Paid" && _invoice.ModifiedDate.HasValue)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Success">
                                    <strong>Paid On:</strong> @_invoice.ModifiedDate.Value.ToString("MMM dd, yyyy")
                                </MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- Invoice Items Card -->
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Invoice Items</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@_invoice.SalesOrder.LineItems" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh>Unit Price</MudTh>
                            <MudTh>Quantity</MudTh>
                            <MudTh>Discount</MudTh>
                            <MudTh>Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2">@context.Product.Name</MudText>
                                <MudText Typo="Typo.caption">@context.Product.SKU</MudText>
                            </MudTd>
                            <MudTd>$@context.UnitPrice.ToString("N2")</MudTd>
                            <MudTd>@context.Quantity @context.Product.UnitOfMeasure</MudTd>
                            <MudTd>$@context.DiscountAmount.ToString("N2")</MudTd>
                            <MudTd><strong>$@context.LineTotal.ToString("N2")</strong></MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudDivider Class="my-4" />

                    <MudGrid Justify="Justify.FlexEnd">
                        <MudItem xs="12" sm="6" md="4">
                            <MudStack Spacing="2">
                                <div class="d-flex justify-space-between">
                                    <MudText>Subtotal:</MudText>
                                    <MudText><strong>$@_invoice.SalesOrder.SubTotal.ToString("N2")</strong></MudText>
                                </div>
                                @if (_invoice.SalesOrder.DiscountAmount > 0)
                                {
                                    <div class="d-flex justify-space-between">
                                        <MudText>Discount:</MudText>
                                        <MudText Color="Color.Success">-$@_invoice.SalesOrder.DiscountAmount.ToString("N2")</MudText>
                                    </div>
                                }
                                @if (_invoice.SalesOrder.TaxAmount > 0)
                                {
                                    <div class="d-flex justify-space-between">
                                        <MudText>Tax:</MudText>
                                        <MudText>$@_invoice.SalesOrder.TaxAmount.ToString("N2")</MudText>
                                    </div>
                                }
                                <MudDivider />
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.h6">Invoice Total:</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Primary">$@_invoice.TotalAmount.ToString("N2")</MudText>
                                </div>
                                <div class="d-flex justify-space-between">
                                    <MudText Color="Color.Success">Amount Paid:</MudText>
                                    <MudText Color="Color.Success"><strong>$@_invoice.PaidAmount.ToString("N2")</strong></MudText>
                                </div>
                                <div class="d-flex justify-space-between">
                                    <MudText Color="@(_invoice.BalanceAmount > 0 ? Color.Warning : Color.Success)">
                                        <strong>Balance Due:</strong>
                                    </MudText>
                                    <MudText Typo="Typo.h6" Color="@(_invoice.BalanceAmount > 0 ? Color.Warning : Color.Success)">
                                        $@_invoice.BalanceAmount.ToString("N2")
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- Payment History Card -->
            @if (_payments.Any())
            {
                <MudCard Elevation="2" Class="mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Payment History</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="@_payments" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Payment #</MudTh>
                                <MudTh>Date</MudTh>
                                <MudTh>Method</MudTh>
                                <MudTh>Reference</MudTh>
                                <MudTh>Amount</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.PaymentNumber</MudTd>
                                <MudTd>@context.PaymentDate.ToString("MMM dd, yyyy")</MudTd>
                                <MudTd>@context.PaymentMethod</MudTd>
                                <MudTd>@(context.Reference ?? "-")</MudTd>
                                <MudTd><strong>$@context.Amount.ToString("N2")</strong></MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@GetPaymentStatusColor(context.Status)">
                                        @context.Status
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>

        <!-- Actions Card -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Invoice Actions</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        @if (_invoice.Status != "Paid" && _invoice.Status != "Cancelled")
                        {
                            <MudButton Variant="Variant.Filled"
                                      Color="Color.Success"
                                      FullWidth="true"
                                      StartIcon="@Icons.Material.Filled.Payment"
                                      OnClick="@RecordPayment">
                                Record Payment
                            </MudButton>
                        }

                        @if (_invoice.Status == "Draft")
                        {
                            <MudButton Variant="Variant.Filled"
                                      Color="Color.Primary"
                                      FullWidth="true"
                                      StartIcon="@Icons.Material.Filled.Send"
                                      OnClick="@(() => UpdateStatus("Sent"))">
                                Mark as Sent
                            </MudButton>
                        }

                        <MudDivider Class="my-2" />

                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                  OnClick="DownloadPdf"
                                  Disabled="@_generatingPdf">
                            @if (_generatingPdf)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Generating...</span>
                            }
                            else
                            {
                                <span>Download PDF</span>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Secondary"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Email"
                                  Disabled="true">
                            Send Email
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Info"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Print"
                                  OnClick="OpenPrintPage">
                            Print Invoice
                        </MudButton>

                        @if (_invoice.Status != "Paid" && _invoice.Status != "Cancelled")
                        {
                            <MudDivider Class="my-2" />
                            <MudButton Variant="Variant.Outlined"
                                      Color="Color.Error"
                                      FullWidth="true"
                                      StartIcon="@Icons.Material.Filled.Cancel"
                                      OnClick="@CancelInvoice">
                                Cancel Invoice
                            </MudButton>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- Related Documents Card -->
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Related Documents</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Text"
                                  Color="Color.Primary"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.ShoppingBag"
                                  Href="@($"/orders/{_invoice.SalesOrder.SalesOrderId}")">
                            View Sales Order
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                  Color="Color.Secondary"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.Person"
                                  Href="@($"/customers/{_invoice.SalesOrder.Customer.CustomerId}")">
                            View Customer
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public int InvoiceId { get; set; }

    private Invoice? _invoice;
    private List<Payment> _payments = new();
    private bool _loading = true;
    private bool _generatingPdf = false;
    private List<BreadcrumbItem> _breadcrumbItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoice();
        await LoadPayments();
        SetupBreadcrumbs();
    }

    private async Task LoadInvoice()
    {
        _loading = true;
        _invoice = await InvoiceService.GetInvoiceByIdAsync(InvoiceId);
        _loading = false;
    }

    private async Task LoadPayments()
    {
        _payments = await PaymentService.GetPaymentsByInvoiceAsync(InvoiceId);
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Invoices", href: "/invoices"),
            new BreadcrumbItem(_invoice?.InvoiceNumber ?? "Details", href: null, disabled: true)
        };
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Draft" => Color.Default,
            "Sent" => Color.Info,
            "Paid" => Color.Success,
            "Overdue" => Color.Error,
            "Cancelled" => Color.Dark,
            _ => Color.Default
        };
    }

    private Color GetPaymentStatusColor(string status)
    {
        return status switch
        {
            "Completed" => Color.Success,
            "Pending" => Color.Warning,
            "Failed" => Color.Error,
            _ => Color.Default
        };
    }

    private async Task RecordPayment()
    {
        if (_invoice == null) return;

        var parameters = new DialogParameters<RecordPaymentDialog>();
        parameters.Add(x => x.InvoiceId, _invoice.InvoiceId);
        parameters.Add(x => x.InvoiceNumber, _invoice.InvoiceNumber);
        parameters.Add(x => x.BalanceAmount, _invoice.BalanceAmount);

        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadInvoice();
            await LoadPayments();
            Snackbar.Add("Payment recorded successfully!", Severity.Success);
        }
    }

    private async Task UpdateStatus(string newStatus)
    {
        if (_invoice == null) return;

        await InvoiceService.UpdateInvoiceStatusAsync(_invoice.InvoiceId, newStatus);
        Snackbar.Add($"Invoice status updated to {newStatus}", Severity.Success);
        await LoadInvoice();
        SetupBreadcrumbs();
    }

    private async Task CancelInvoice()
    {
        if (_invoice == null) return;

        var result = await DialogService.ShowMessageBox(
            "Confirm Cancellation",
            "Are you sure you want to cancel this invoice? This action cannot be undone.",
            yesText: "Cancel Invoice",
            cancelText: "Keep Invoice");

        if (result == true)
        {
            await InvoiceService.UpdateInvoiceStatusAsync(_invoice.InvoiceId, "Cancelled");
            Snackbar.Add("Invoice cancelled", Severity.Info);
            await LoadInvoice();
        }
    }

    private async Task DownloadPdf()
    {
        if (_invoice == null) return;

        _generatingPdf = true;
        StateHasChanged();

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var pdfBytes = await GotenbergService.GenerateInvoicePdfAsync(_invoice.InvoiceId, baseUrl);

            if (pdfBytes != null)
            {
                var fileName = $"Invoice-{_invoice.InvoiceNumber}.pdf";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pdfBytes));
                Snackbar.Add("PDF generated successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to generate PDF. Make sure Gotenberg service is running.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating PDF: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generatingPdf = false;
            StateHasChanged();
        }
    }

    private void OpenPrintPage()
    {
        if (_invoice == null) return;
        var printUrl = $"/print/invoice/{_invoice.InvoiceId}";
        Navigation.NavigateTo(printUrl, true);
    }
}
