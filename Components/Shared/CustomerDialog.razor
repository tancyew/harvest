@using Harvest.Models
@using Harvest.Services
@inject CustomerService CustomerService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">Business Information</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Customer.BusinessName"
                                 Label="Business Name"
                                 Required="true"
                                 RequiredError="Business name is required" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Customer.Address"
                                 Label="Address"
                                 Lines="2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.City"
                                 Label="City" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.PostalCode"
                                 Label="Postal Code" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.Country"
                                 Label="Country" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.TaxId"
                                 Label="Tax ID (Optional)" />
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Contact Information</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Customer.User.FullName"
                                 Label="Contact Person Name"
                                 Required="true"
                                 RequiredError="Contact person name is required" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.User.Email"
                                 Label="Email"
                                 InputType="InputType.Email"
                                 Required="true"
                                 RequiredError="Email is required" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Customer.User.Phone"
                                 Label="Phone"
                                 Required="true"
                                 RequiredError="Phone is required" />
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Credit Settings</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="Customer.CreditLimit"
                                    Label="Credit Limit"
                                    Min="0"
                                    Step="100M"
                                    Format="N2"
                                    Adornment="Adornment.Start"
                                    AdornmentText="$" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" @bind-Value="Customer.IsActive"
                              Label="Active"
                              Color="Color.Success" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                  Variant="Variant.Filled"
                  OnClick="Save"
                  Disabled="@(!_isValid)">
            @(IsNew ? "Create" : "Update")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Customer Customer { get; set; } = new();

    [Parameter]
    public bool IsNew { get; set; }

    private MudForm? _form;
    private bool _isValid;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        await _form!.Validate();

        if (!_isValid)
        {
            Snackbar.Add("Please fix validation errors", Severity.Error);
            return;
        }

        try
        {
            if (IsNew)
            {
                // Create user first
                Customer.User.Role = "Customer";
                Customer.User.UserType = "Customer";

                await CustomerService.CreateCustomerAsync(Customer);
            }
            else
            {
                await CustomerService.UpdateCustomerAsync(Customer);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
